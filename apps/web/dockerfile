# ==========================================
# Stage 1: Build React SPA
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

# Install exact pnpm version from package.json
RUN corepack enable && corepack prepare pnpm@11.17.0 --activate

# 1. Copy workspace manifests first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/types/package.json ./packages/types/
COPY apps/web/package.json ./apps/web/

# 2. Install only dependencies needed by web & @repo/types
RUN pnpm install --frozen-lockfile --filter web...

# 3. Copy source code and build static bundle
COPY packages/types ./packages/types
COPY apps/web ./apps/web

RUN pnpm --filter web build

# ==========================================
# Stage 2: Serve with Hardened Nginx
# ==========================================
FROM nginx:alpine AS runner

RUN apk update && apk upgrade --no-cache

# Copy SPA Nginx config and compiled static files
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]