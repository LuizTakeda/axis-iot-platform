# ==========================================
# Stage 1: Install & Generate Prisma Client
# ==========================================
FROM node:24-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.17.0 --activate

# 1. Copy workspace manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/types/package.json ./packages/types/
COPY apps/api/package.json ./apps/api/

# 2. Install dependencies for api and @repo/types
RUN pnpm install --frozen-lockfile --filter api...

# 3. Copy source files & Prisma schema
COPY packages/types ./packages/types
COPY apps/api ./apps/api

# 4. Generate Prisma Client & compile JS bundle into dist/main.js
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN pnpm --filter api generate && pnpm --filter api build

# ==========================================
# Stage 2: Hardened Production Runtime
# ==========================================
FROM node:24-alpine AS runner

# Patch Alpine packages & remove unused npm/yarn (eliminates npm CVEs)
RUN apk update && apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn*

WORKDIR /app
ENV NODE_ENV=production

# Copy workspace runtime files & compiled bundle with non-root ownership
COPY --from=builder --chown=node:node /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=node:node /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=builder --chown=node:node /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder --chown=node:node /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=node:node /app/apps/api/node_modules ./apps/api/node_modules

WORKDIR /app/apps/api

# Run as non-root user
USER node

EXPOSE 3000

# Apply pending DB migrations on startup, then start compiled Fastify bundle
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/main.js"]